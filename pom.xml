<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>paprika</artifactId>
	<groupId>de.svenkubiak</groupId>
	<version>0.12.1-SNAPSHOT</version>
	<packaging>jar</packaging>
	<url>https://github.com/svenkubiak/paprika</url>
	<properties>
		<mangooio.version>10.12.2</mangooio.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<jdk.version>25</jdk.version>
		<node.version>v24.20.0</node.version>
	</properties>
	<build>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<includes>
					<include>**/*</include>
				</includes>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*</include>
				</includes>
				<excludes>
					<exclude>jpackage/**</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>2.0.2</version>
				<configuration>
					<workingDirectory>admin-ui</workingDirectory>
					<installDirectory>${project.basedir}/.frontend</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install node and npm</id>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<nodeVersion>${node.version}</nodeVersion>
							<npmVersion>11.2.0</npmVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm install</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>install</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm build</id>
						<goals>
							<goal>npm</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>${project.basedir}/src/main/resources/files/assets/js</directory>
							<followSymlinks>false</followSymlinks>
						</fileset>
						<fileset>
							<directory>${project.basedir}/src/main/resources/files/assets/css</directory>
							<followSymlinks>false</followSymlinks>
						</fileset>
						<fileset>
							<directory>${project.basedir}/src/main/resources/files/assets/admin</directory>
							<followSymlinks>false</followSymlinks>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>versions-maven-plugin</artifactId>
				<version>2.21.0</version>
				<configuration>
					<ruleSet>
						<ignoreVersions>
							<ignoreVersion>
								<type>regex</type>
								<version>.*(beta|Beta|alpha|Alpha|rc|RC).*</version>
							</ignoreVersion>
						</ignoreVersions>
					</ruleSet>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>clean-stale-admin-target-assets</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<delete dir="${project.build.outputDirectory}/files/assets/js" quiet="true" />
								<delete dir="${project.build.outputDirectory}/files/assets/css" quiet="true" />
								<delete dir="${project.build.outputDirectory}/files/assets/admin" quiet="true" />
								<delete file="${project.build.outputDirectory}/files/assets/manifest.json" quiet="true" />
							</target>
						</configuration>
					</execution>
					<execution>
						<!--
							Guards against reintroducing the ?id= list-rule bypass: Request.getParameter(...)
							merges route and query parameters, so a client can supply a value for a name the
							route never declared. It must therefore not be used anywhere in the production
							code: use getPathParameter(...)/hasPathParameter(...) for trusted route values,
							or getQueryParameter(...) for real client input.

							Scanning all of src/main/java rather than the places the bug once appeared in:
							a new filter, controller or helper is covered from the start instead of being
							protected only after the next incident. There are currently no exceptions - a
							deliberate one has to be excluded here explicitly and with a reason.
						-->
						<id>ban-ambiguous-request-getParameter</id>
						<phase>validate</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<fileset id="ambiguous.getparameter.files" dir="${project.basedir}/src/main/java">
									<include name="**/*.java" />
									<contains text=".getParameter(" casesensitive="true" />
								</fileset>
								<resourcecount property="ambiguous.getparameter.count" refid="ambiguous.getparameter.files" />
								<fail message="Found Request.getParameter(...) in src/main/java. It merges route and query parameters, so a client can forge a value for a name the route never declared. Use getPathParameter(...)/hasPathParameter(...) for trusted route values, or getQueryParameter(...) for real client input - see the ?id= list-rule bypass fix.">
									<condition>
										<not>
											<equals arg1="${ambiguous.getparameter.count}" arg2="0" />
										</not>
									</condition>
								</fail>
							</target>
						</configuration>
					</execution>
					<execution>
						<!--
							The suites below are the executable specification of who may access what and
							of what may leave the instance. Deleting or renaming one of them would remove
							that specification without anything turning red, so their presence is checked
							in the validate phase - which runs even for a -DskipTests packaging build.

							This cannot verify that they are executed: that is the build job's
							responsibility, see the Jenkinsfile (mvn clean verify, never -DskipTests).
						-->
						<id>require-security-test-suites</id>
						<phase>validate</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<fileset id="security.suites" dir="${project.basedir}/src/test/java/security">
									<include name="AuthorizationMatrixIntegrationTest.java" />
									<include name="TenantIsolationIntegrationTest.java" />
									<include name="OutboundSecretLeakIntegrationTest.java" />
									<include name="SuperadminTokenRevalidationIntegrationTest.java" />
								</fileset>
								<resourcecount property="security.suites.count" refid="security.suites" />
								<fail message="A suite in src/test/java/security is missing. These are the executable specification of the access rules, the tenant isolation and the outbound secret handling - they must not be removed or renamed without replacement.">
									<condition>
										<not>
											<equals arg1="${security.suites.count}" arg2="4" />
										</not>
									</condition>
								</fail>
							</target>
						</configuration>
					</execution>
					<execution>
						<!--
							Guards against reintroducing the fail-open list: CollectionRecordService#list
							must refuse when the AuthorizationDecision of a request carries no scoping query,
							instead of falling back to an empty filter and returning every record of the
							collection. Any Filters.empty() in that class is that fallback in disguise - the
							unscoped list of the admin bypass is built in ApiAuthFilter, not here.
						-->
						<id>ban-fail-open-list-filter</id>
						<phase>validate</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<fileset id="failopen.listfilter.files" dir="${project.basedir}/src/main/java">
									<include name="services/CollectionRecordService.java" />
									<contains text="Filters.empty()" casesensitive="true" />
								</fileset>
								<resourcecount property="failopen.listfilter.count" refid="failopen.listfilter.files" />
								<fail message="CollectionRecordService uses Filters.empty(). A request without a scoping query in its AuthorizationDecision must be refused (fail closed), never listed unscoped - see the ?id= list-rule bypass fix.">
									<condition>
										<not>
											<equals arg1="${failopen.listfilter.count}" arg2="0" />
										</not>
									</condition>
								</fail>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
				<configuration>
					<release>25</release>
					<debug>false</debug>
					<showDeprecation>true</showDeprecation>
					<fork>true</fork>
					<compilerArgs>
						<arg>-parameters</arg>
						<arg>-J-Xmx2G</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				<version>5.8.0.7211</version>
			</plugin>
			<plugin>
				<groupId>io.mangoo</groupId>
				<artifactId>mangooio-maven-plugin</artifactId>
				<version>${mangooio.version}</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<excludes>
						<exclude>**/log4j2-test*</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.DontIncludeResourceTransformer" />
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>io.mangoo.core.Application</mainClass>
									<manifestEntries>
										<Multi-Release>true</Multi-Release>
									</manifestEntries>
								</transformer>
							</transformers>
							<artifactSet>
								<excludes>
									<exclude>junit:*</exclude>
									<exclude>rhino:*</exclude>
									<exclude>io.bit3:*</exclude>
									<exclude>com.hazelcast:*</exclude>
									<exclude>org.eclipse.jetty:*</exclude>
									<exclude>org.glassfish.jersey.media:*</exclude>
									<exclude>org.glassfish.jersey.core:*</exclude>
									<exclude>org.glassfish.hk2:*</exclude>
									<exclude>org.glassfish.hk2.external:*</exclude>
									<exclude>com.google.code.findbugs:*</exclude>
									<exclude>com.google.xing:*</exclude>
									<exclude>com.icegreen:*</exclude>
									<exclude>org.hamcrest:*</exclude>
									<exclude>org.cactoos:*</exclude>
									<exclude>org.llorllale:*</exclude>
								</excludes>
							</artifactSet>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<promoteTransitiveDependencies>true</promoteTransitiveDependencies>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
							<finalName>paprika</finalName>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<rules>
						<DependencyConvergence>
							<uniqueVersions>false</uniqueVersions>
						</DependencyConvergence>
					</rules>
				</configuration>
				<executions>
					<execution>
						<id>enforce</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<phase>validate</phase>
					</execution>
					<execution>
						<id>enforce-maven</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>3.9.10</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>enforce-ban-circular-dependencies</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<banCircularDependencies/>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
				<dependencies>
					<dependency>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>extra-enforcer-rules</artifactId>
						<version>1.12.0</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.3</version>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>io.mangoo</groupId>
			<artifactId>mangooio-core</artifactId>
			<version>${mangooio.version}</version>
		</dependency>
		<dependency>
			<groupId>io.mangoo</groupId>
			<artifactId>mangooio-test</artifactId>
			<version>${mangooio.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>de.svenkubiak</groupId>
			<artifactId>simple-http</artifactId>
			<version>3.0.0</version>
		</dependency>
	</dependencies>
	<profiles>
		<profile>
			<id>package-deb-x86</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.3</version>
						<executions>
							<execution>
								<id>jpackage-deb-x86</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>deb</argument>
										<argument>--name</argument>
										<argument>paprika</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}</argument>
										<argument>--main-jar</argument>
										<argument>paprika.jar</argument>
										<argument>--main-class</argument>
										<argument>io.mangoo.core.Application</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/dist</argument>
										<argument>--install-dir</argument>
										<argument>/opt</argument>
										<argument>--linux-package-name</argument>
										<argument>paprika</argument>
										<argument>--resource-dir</argument>
										<argument>${project.basedir}/src/main/resources/jpackage</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>package-deb-arm64</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.6.3</version>
						<executions>
							<execution>
								<id>jpackage-deb-arm64</id>
								<phase>package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>jpackage</executable>
									<arguments>
										<argument>--type</argument>
										<argument>deb</argument>
										<argument>--name</argument>
										<argument>paprika</argument>
										<argument>--input</argument>
										<argument>${project.build.directory}</argument>
										<argument>--main-jar</argument>
										<argument>paprika.jar</argument>
										<argument>--main-class</argument>
										<argument>io.mangoo.core.Application</argument>
										<argument>--app-version</argument>
										<argument>${project.version}</argument>
										<argument>--dest</argument>
										<argument>${project.build.directory}/dist</argument>
										<argument>--install-dir</argument>
										<argument>/opt</argument>
										<argument>--linux-package-name</argument>
										<argument>paprika</argument>
										<argument>--resource-dir</argument>
										<argument>${project.basedir}/src/main/resources/jpackage</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>ci</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.jacoco</groupId>
						<artifactId>jacoco-maven-plugin</artifactId>
						<version>0.8.15</version>
						<executions>
							<execution>
								<id>prepare-agent</id>
								<goals>
									<goal>prepare-agent</goal>
								</goals>
							</execution>
							<execution>
								<id>report</id>
								<goals>
									<goal>report</goal>
								</goals>
								<configuration>
									<formats>
										<format>XML</format>
									</formats>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<!--
				Mutation testing for the packages that decide access: they are small, purely logical
				and the place where a silently inverted condition has caused real access control
				bugs. Line coverage cannot tell whether a test would notice such an inversion,
				mutation coverage can.

				Run with: mvn -P mutation test
				Report:   target/pit-reports/index.html
			-->
			<id>mutation</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>1.20.4</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>1.2.3</version>
							</dependency>
						</dependencies>
						<configuration>
							<!--
								The rule engine and the ownership helpers: the decision logic itself,
								free of I/O and therefore meaningful to mutate. The filters and services
								around them are covered by the integration suites instead, which PIT
								cannot drive: they share one embedded MongoDB and build on each other's
								state, so PIT's isolated re-execution reports them as failing.
							-->
							<targetClasses>
								<param>rules.*</param>
								<param>utils.OwnerFieldUtils</param>
							</targetClasses>
							<targetTests>
								<param>rules.*</param>
								<param>utils.*</param>
							</targetTests>
							<mutators>
								<mutator>STRONGER</mutator>
							</mutators>
							<outputFormats>
								<param>HTML</param>
								<param>XML</param>
							</outputFormats>
							<timestampedReports>false</timestampedReports>
							<threads>4</threads>
							<!--
								A ratchet, not a goal: set just below the score the suite reaches
								today (67% mutation / 87% line), so that a change weakening the
								tests around the rule engine fails the build. Raise when the score
								improves, never lower to make a build pass.
							-->
							<mutationThreshold>65</mutationThreshold>
							<coverageThreshold>85</coverageThreshold>
						</configuration>
						<executions>
							<execution>
								<id>mutation-coverage</id>
								<phase>test</phase>
								<goals>
									<goal>mutationCoverage</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>