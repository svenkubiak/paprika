{
  "name": "paprika-admin-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prune-build-output.mjs",
    "prebuild": "rm -rf ../src/main/resources/files/assets/js ../src/main/resources/files/assets/css ../src/main/resources/files/assets/manifest.json ../src/main/resources/files/assets/admin ../src/main/resources/files/assets/.vite && find ../src/main/resources/files/assets/img -mindepth 1 ! -name 'favicon.png' -delete 2>/dev/null || true",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/ui": "^4.11.1",
    "@vueuse/core": "^14.4.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "esbuild@0.25.12": true,
    "vue-demi@0.14.10": true,
    "fsevents@2.3.3": true
  }
}
