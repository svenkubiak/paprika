[Unit]
Description=Paprika Application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=paprika
Group=paprika
WorkingDirectory=/opt/paprika
EnvironmentFile=/opt/paprika/.env
ExecStart=/opt/paprika/bin/paprika
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paprika

# ── Process hardening ─────────────────────────────────────────
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native

# ── Filesystem hardening ──────────────────────────────────────
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# Only the storage directory may be written to at runtime
ReadWritePaths=/opt/paprika/storage

# ── Network hardening ─────────────────────────────────────────
# AF_UNIX is required for some JVM internals
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# ── Capability hardening ──────────────────────────────────────
# Port 8080 does not require any capabilities
CapabilityBoundingSet=
AmbientCapabilities=

# ── File creation mask ────────────────────────────────────────
UMask=0027

# NOTE: MemoryDenyWriteExecute is intentionally NOT set.
# The JVM JIT compiler must write executable memory pages at runtime.

[Install]
WantedBy=multi-user.target
